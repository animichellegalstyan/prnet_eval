// script generated by Gemini Flash 3.5 on 01.07.2026
// updated last on: 14.07.2026
process training {

    conda '/home/ani/miniconda3/envs/prnet_run_env'

    maxForks 1 // force sequencial run (parallel is default) 
    afterScript """
    TARGET_NODE=\$(cat .node_name 2>/dev/null)
    if [ -n "\$TARGET_NODE" ] && [ "\$TARGET_NODE" != "localhost" ]; then 
        ssh -o StrictHostKeyChecking=no \$TARGET_NODE 'rm -rf /storage/mi/galstyaa05/tmp_scratch/${split_key}'
    fi
    """

    input:
    path preprocessed_dataset
    val split_key
    val smoke_test

    output:
    path "loss_${split_key}.h5ad", emit: training_loss
    path "metrics_${split_key}.h5ad", emit: training_metrics
    path "checkpoint_test", emit: checkpoints, optional: true

    script:
    def test_flag = smoke_test ? "--smoke_test" : ""
    def is_local = (workflow.profile != 'cuda_server') 
    if (is_local) {
        """
        echo "========================================================="
        echo "            RUNNING TRAINING LOCALLY                     "
        echo "========================================================="
        echo "localhost" > .node_name

        # Match path structure locally if you use an environment, or just run python directly
        export PYTHONPATH="${projectDir}"
        
        python -m train_lincs \
            --input_data ${preprocessed_dataset} \
            --split_key ${split_key} \
            ${test_flag}

        # The python script outputs loss_data.h5ad, metrics_data.h5ad, and checkpoint_test
        # directly into the Nextflow task execution directory.
        """
    } else {   
    """
    echo "========================================================="
    echo "       DYNAMIC GPU SELECTION & RESOURCE CHECKS           "
    echo "========================================================="
    
    TARGET_NODE=""
    for i in {1..6}; do
        NODE=\$(printf "cuda%02d" \$i)
        echo "Checking resource utilization directly on \$NODE..."
        
        GPU_USERS=\$(ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no \$NODE "nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | wc -l" 2>/dev/null)
        
        if [ "\$GPU_USERS" = "0" ]; then
            TARGET_NODE=\$NODE
            # Save the node name locally so afterScript can find it later!
            echo "\$TARGET_NODE" > .node_name
            echo "SUCCESS: Found completely idle GPU on node: \$TARGET_NODE"
            echo "======> RUNNING LIVE ON NODE: \$TARGET_NODE <======"
            break
        fi
    done

    if [ -z "\$TARGET_NODE" ]; then
        echo "CRITICAL ABORT: All cluster nodes currently have active GPU users!" >&2
        exit 1
    fi

    # Set up our directory paths
    PERSISTENT_DATA_DIR="/storage/mi/galstyaa05/prnet_project_data"
    CLUSTER_WORK_DIR="/storage/mi/galstyaa05/tmp_scratch/${split_key}"

    echo "========================================================="
    echo "       SMART SYNCING DATA & CODE TO \$TARGET_NODE        "
    echo "========================================================="
    ssh -o StrictHostKeyChecking=no \$TARGET_NODE "mkdir -p \$PERSISTENT_DATA_DIR \$CLUSTER_WORK_DIR"

    rsync -avzL -e "ssh -o StrictHostKeyChecking=no" ${preprocessed_dataset} \$TARGET_NODE:\$PERSISTENT_DATA_DIR/
    rsync -avz -e "ssh -o StrictHostKeyChecking=no" --include='*.py' --exclude='*' $baseDir/ \$TARGET_NODE:\$CLUSTER_WORK_DIR/

    echo "========================================================="
    echo "       REMOTE TRAINING EXECUTION ON \$TARGET_NODE         "
    echo "========================================================="
    ssh -o StrictHostKeyChecking=no \$TARGET_NODE "
        source /storage/mi/galstyaa05/miniconda3/bin/activate /storage/mi/galstyaa05/miniconda3/envs/prnet_run_env
        
        cd \$CLUSTER_WORK_DIR

        export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
        export TORCH_HOME=\"/storage/mi/galstyaa05/tmp_scratch/.cache/torch\"
        export MPLCONFIGDIR=\"/storage/mi/galstyaa05/tmp_scratch/.cache/matplotlib\"
        export PYTHONPATH=\"\$CLUSTER_WORK_DIR:/storage/mi/galstyaa05\"

        python -m train_lincs --input_data \$PERSISTENT_DATA_DIR/\$(basename ${preprocessed_dataset}) --split_key ${split_key} ${test_flag}
    "

    echo "========================================================="
    echo "       DOWNLOADING METRICS & CLEANING UP TASK            "
    echo "========================================================="
    ssh -o StrictHostKeyChecking=no \$TARGET_NODE "find \$CLUSTER_WORK_DIR -mindepth 2 -name 'loss_data.h5ad' -exec cp {} \$CLUSTER_WORK_DIR/ \;" 2>/dev/null || true
    ssh -o StrictHostKeyChecking=no \$TARGET_NODE "find \$CLUSTER_WORK_DIR -mindepth 2 -name 'metrics_data.h5ad' -exec cp {} \$CLUSTER_WORK_DIR/ \;" 2>/dev/null || true

    scp -o StrictHostKeyChecking=no \$TARGET_NODE:\$CLUSTER_WORK_DIR/loss_data.h5ad loss_data.h5ad 2>/dev/null || true
    scp -o StrictHostKeyChecking=no \$TARGET_NODE:\$CLUSTER_WORK_DIR/metrics_data.h5ad metrics_data.h5ad 2>/dev/null || true

    scp -r -o StrictHostKeyChecking=no \$TARGET_NODE:\$CLUSTER_WORK_DIR/checkpoint_test ./ 2>/dev/null || true
    
    echo "Training step finished. Handing over to Nextflow to ingest files and run cleanup hook."
    """
    }
}
