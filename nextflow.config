conda.enabled = true

process {
    executor = 'local'
    withName: 'loadExpressionData' {
        cpus   = 4
        memory = '16 GB' 
    }
}

process {
    executor = 'local'
    withName: 'normalizeAndSplit' {
        cpus   = 4
        memory = '16 GB' 
    }
}


/*
 * Pipeline parameters
 */
params {
    batch                = "batch_run_00"
    splitting_strat      = "canonical_smiles"
    metadata_folder_path = '/Users/ani/Thesis/prnet_eval/dataset/metadata/LINCS'
    gctx_cp_path         = '/Users/ani/Thesis/prnet_eval/dataset/data/LINCS/level3_beta_trt_cp_n1805898x12328.gctx'
    gctx_ctl_path        = '/Users/ani/Thesis/prnet_eval/dataset/data/LINCS/level3_beta_ctl_n188708x12328.gctx'
}

/*
 * Profiles
 */
profiles {
    my_laptop {
        process.executer = 'local'
        conda.enabled = true
    }
}

/*
 * Output
 */
output {
    directory = "${projectDir}"
}




