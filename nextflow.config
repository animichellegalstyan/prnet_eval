conda.enabled = true
process.executor = 'local' //default for all processes except training


process {
    executor = 'local'
    withName: 'loadExpressionData' {
        cpus   = 4
        memory = '16 GB' 
    }
}

process {
    executor = 'local'
    withName: 'splitData' {
        cpus   = 4
        memory = '16 GB' 
    }
}


/*
 * Pipeline parameters
 */
params {
    batch                = "batch_run_00"
    mode                 = String

    splitting_strats     = ["canonical_smiles", "fingerprint_smiles"]
    train_split          = "canonical_smiles"
    smoke_test           = true
    delete_fp_duplicates = false
    metadata_folder_path = '/home/ani/Documents/uni/prnet_eval/dataset/metadata/LINCS'
    split_dataset_path   = null
    gctx_cp_path         = '/home/ani/Documents/uni/prnet_eval/dataset/data/LINCS/level3_beta_trt_cp_n1805898x12328.gctx'
    gctx_ctl_path        = '/home/ani/Documents/uni/prnet_eval/dataset/data/LINCS/level3_beta_ctl_n188708x12328.gctx'
}

/*
 * Profiles
 */
profiles {
    my_laptop {
        process.executer = 'local'
        conda.enabled = true
    }

    cuda_server {
        cleanup = true // Deletes the local laptop work cache files upon success
        workDir = './work' // Orchestrates tracking files cleanly on your Mac

        process {
            withName: 'training' {
                // Keep the orchestrator engine local. Runs trainPRnet script that navigates to the cluster.
                executor = 'local'
            }
        }
    }
}

/*
 * Output
 */
output {
    directory = "${projectDir}"
}




